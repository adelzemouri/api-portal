# Référence de toutes les variables d'environnement lues par le BFF en profil réel (ni --profile=mock).
#
# Ce fichier n'est PAS chargé automatiquement par l'application (Spring Boot ne lit pas de .env sans
# dépendance dédiée, volontairement absente ici — cf. CLAUDE.md, « tout ajout de dépendance doit être
# justifié »). C'est un aide-mémoire à copier/servir tel quel à ce qui injecte réellement les variables :
# gabarit Vault Agent, --env-file docker, variables masquées GitLab CI, config de service Virtuozzo…
#
# Les variables « Obligatoire » sont déjà déclarées avec ${VAR} dans application.yml : sans elles, le
# démarrage échoue. Les variables « Facultatif » ne sont déclarées nulle part dans application.yml — c'est
# la résolution relâchée standard de Spring Boot (nom de variable SCREAMING_SNAKE_CASE -> chemin de
# propriété en kebab-case) qui les relie directement aux classes de configuration, sans rien à modifier
# dans le YAML. Ce mécanisme précis est vérifié par un test (EnvironmentVariableBindingTest) : ce n'est
# pas une supposition. Une section facultative totalement absente ne fait pas planter le démarrage ; la
# fonctionnalité correspondante est simplement désactivée (le front l'indique).

# ============================================================================
# WSO2 — Obligatoire pour chacun des 4 environnements (DEV, SIM, UAT, EXP)
# Prérequis par control plane : voir « Prérequis » dans README.md (compte de service, DCR).
# ============================================================================

# Chemin du PEM de la CA groupe, utilisée pour valider les 4 control planes WSO2 et Splunk.
GROUP_CA_PEM_PATH=

# --- DEV ---
WSO2_DEV_URL=                    # ex. https://apim-dev.bank.internal:9443
WSO2_DEV_CLIENT_ID=              # issu du DCR (voir README.md)
WSO2_DEV_CLIENT_SECRET=
WSO2_DEV_USERNAME=               # compte de service, lecture seule
WSO2_DEV_PASSWORD=

# --- SIM ---
WSO2_SIM_URL=
WSO2_SIM_CLIENT_ID=
WSO2_SIM_CLIENT_SECRET=
WSO2_SIM_USERNAME=
WSO2_SIM_PASSWORD=

# --- UAT ---
WSO2_UAT_URL=
WSO2_UAT_CLIENT_ID=
WSO2_UAT_CLIENT_SECRET=
WSO2_UAT_USERNAME=
WSO2_UAT_PASSWORD=

# --- EXP (production) ---
WSO2_EXP_URL=
WSO2_EXP_CLIENT_ID=
WSO2_EXP_CLIENT_SECRET=
WSO2_EXP_USERNAME=
WSO2_EXP_PASSWORD=

# ============================================================================
# Adresses affichées aux développeurs — Facultatif, par environnement
# Toutes en https (le démarrage échoue sinon si une valeur est posée). Absentes = le portail n'affiche
# simplement pas le lien correspondant. Vous avez dit y revenir plus tard : rien ici n'est urgent.
# ============================================================================

PORTAL_LINKS_DEPLOY_COMPONENT_URL=                          # composant GitLab « swagger-deploy »

# Répéter le bloc pour DEV, SIM, UAT, EXP (remplacer _DEV_ par _SIM_ / _UAT_ / _EXP_).
PORTAL_LINKS_ENVIRONMENTS_DEV_PUBLISHER_URL=
PORTAL_LINKS_ENVIRONMENTS_DEV_DEVPORTAL_URL=
PORTAL_LINKS_ENVIRONMENTS_DEV_IDENTITY_SERVER_URL=
PORTAL_LINKS_ENVIRONMENTS_DEV_GATEWAY_HTTPS_PORT=            # entier ; absent = 443

# ============================================================================
# Métriques de trafic (Splunk) — Facultatif
# Sans PORTAL_METRICS_SPLUNK_BASE_URL, le portail n'affiche simplement pas de trafic.
# Détail et exemple commenté : README.md, section « Métriques de trafic (Splunk) ».
# ============================================================================

PORTAL_METRICS_SPLUNK_BASE_URL=                              # ex. https://splunk.bank.internal:8089
PORTAL_METRICS_SPLUNK_TOKEN=                                 # jeton d'un compte lecture seule (recherche uniquement)
PORTAL_METRICS_SPLUNK_SSL_BUNDLE=group-ca

# Un bloc par environnement à activer (DEV, SIM, UAT, EXP) : au minimum l'index.
PORTAL_METRICS_SPLUNK_ENVIRONMENTS_DEV_INDEX=                # ex. wso2_apim_dev
PORTAL_METRICS_SPLUNK_ENVIRONMENTS_DEV_FILTER=                # facultatif, ex. sourcetype="wso2:apim:analytics"

# Noms des champs des événements : à ne redéfinir QUE si vos événements Splunk diffèrent des valeurs par
# défaut ci-dessous (celles de l'analytique WSO2 4.x). Ne renseigner api-id / application-id que s'ils sont
# présents dans TOUS les événements (Splunk exclut d'une agrégation les lignes où un champ de regroupement manque).
# PORTAL_METRICS_SPLUNK_FIELDS_API_NAME=apiName
# PORTAL_METRICS_SPLUNK_FIELDS_API_VERSION=apiVersion
# PORTAL_METRICS_SPLUNK_FIELDS_APPLICATION_NAME=applicationName
# PORTAL_METRICS_SPLUNK_FIELDS_STATUS=proxyResponseCode
# PORTAL_METRICS_SPLUNK_FIELDS_LATENCY=responseLatency
# PORTAL_METRICS_SPLUNK_FIELDS_API_ID=
# PORTAL_METRICS_SPLUNK_FIELDS_APPLICATION_ID=

# ============================================================================
# Divers
# ============================================================================

# Ne jamais positionner le profil "mock" ici : c'est lui qui fait tourner le portail sur données factices.
# SPRING_PROFILES_ACTIVE=
